{
  "rewrites": [
    { "source": "/.well-known/oauth-authorization-server(.*)", "destination": "/api/oauth?op=metadata" },
    { "source": "/.well-known/openid-configuration(.*)", "destination": "/api/oauth?op=metadata" },
    { "source": "/.well-known/oauth-protected-resource(.*)", "destination": "/api/oauth?op=resource" },
    { "source": "/oauth/register", "destination": "/api/oauth?op=register" },
    { "source": "/oauth/authorize", "destination": "/api/oauth?op=authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth?op=token" },
    { "source": "/((?!api/|assets/|oauth/|\\.well-known/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(sw.js|registerSW.js|manifest.webmanifest|index.html)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
